# Cloudflare Worker의 공개 HTTPS 주소입니다. 끝의 / 는 생략합니다.
VITE_API_BASE_URL=https://example.workers.dev

# 모든 플랫폼 초기화에는 Google Cloud의 "웹 애플리케이션" 클라이언트 ID를 사용합니다.
VITE_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# true인 동안 Google 공식 테스트 광고 단위를 사용합니다.
VITE_ADMOB_TEST_MODE=true
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_ADMOB_IOS_REWARDED_ID=

# 스토어 콘솔에 만든 상품 ID를 쉼표로 구분합니다.
VITE_STORE_PRODUCT_IDS=

# 앱 식별자와 이름은 capacitor.config.json에서 관리합니다.
