{
  "name": "midnight-dorm-coop-defense",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=e2e WRANGLER_LOG_PATH=.wrangler/logs/dev.log vite --mode e2e --host 0.0.0.0",
    "icons": "node scripts/generate-icons.mjs",
    "sprites": "node scripts/normalize_sprite_atlases.mjs",
    "sprites:repair-special-ops": "node scripts/repair_special_ops_sprites.mjs",
    "sprites:verify": "node scripts/normalize_sprite_atlases.mjs --verify",
    "ranks:normalize": "node scripts/normalize-rank-badges.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply midnight-dorm-accounts --local",
    "db:migrate:remote": "wrangler d1 migrations apply midnight-dorm-accounts --remote",
    "build": "npm run icons && npm run typecheck && WRANGLER_LOG_PATH=.wrangler/logs/build.log vite build && npm run client:prune-assets && npm run client:optimize-images",
    "build:native": "npm run icons && npm run native:splash && npm run typecheck && WRANGLER_LOG_PATH=.wrangler/logs/build-native.log vite build --mode native && npm run native:prune-assets && npm run native:optimize-images && npx cap sync",
    "client:optimize-images": "node scripts/optimize-native-images.mjs",
    "client:prune-assets": "node scripts/prune-native-assets.mjs",
    "native:optimize-images": "npm run client:optimize-images",
    "native:prune-assets": "npm run client:prune-assets",
    "native:splash": "node scripts/generate-native-splash.mjs",
    "native:sync": "npx cap sync",
    "native:add:android": "npx cap add android",
    "native:add:ios": "npx cap add ios",
    "native:open:android": "npx cap open android",
    "native:open:ios": "npx cap open ios",
    "preview": "WRANGLER_LOG_PATH=.wrangler/logs/preview.log vite preview --host 0.0.0.0",
    "deploy": "npm run build && npm run db:migrate:remote && WRANGLER_LOG_PATH=.wrangler/logs/deploy.log wrangler deploy --keep-vars"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capawesome/capacitor-google-sign-in": "^0.1.2",
    "@capgo/native-purchases": "^8.6.4",
    "@types/three": "^0.184.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "jose": "^6.2.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@cloudflare/vite-plugin": "1.40.0",
    "@playwright/test": "1.61.1",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "@cloudflare/vite-plugin": {
      "miniflare": "4.20260708.1",
      "ws": "8.21.1"
    }
  }
}
